<Page
    x:Class="ZoDream.Spider.Pages.RulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:ZoDream.Spider.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sctl="clr-namespace:ZoDream.Shared.Controls;assembly=ZoDream.Shared.Controls"
    xmlns:vm="clr-namespace:ZoDream.Spider.ViewModels"
    x:Name="root"
    Title="规则管理"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:RuleViewModel />
    </Page.DataContext>

    <Page.Resources>
        <ResourceDictionary>
            <Style TargetType="RadioButton">
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <sctl:IconButton
                Command="{Binding BackCommand}"
                Icon="&#xE112;"
                Label="返回" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <sctl:IconButton
                    Command="{Binding AddCommand}"
                    Icon="&#xE109;"
                    Label="添加" />
                <sctl:IconButton
                    Command="{Binding HomeCommand}"
                    Icon="&#xE10F;"
                    Label="首页" />
                <sctl:IconButton
                    Command="{Binding SettingCommand}"
                    Icon="&#xE115;"
                    Label="设置" />
            </StackPanel>

        </Grid>
        <ListBox
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            ItemsSource="{Binding GroupItems}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Grid.Row="1" Text="{Binding Rules.Count, StringFormat='共{0}条规则'}" />
                        <Button
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Command="{Binding ElementName=root, Path=DataContext.RuleListCommand}"
                            CommandParameter="{Binding}"
                            Content="&#xE71D;"
                            Style="{StaticResource ListIconBtn}"
                            ToolTip="编辑规则" />
                        <Button
                            Grid.RowSpan="2"
                            Grid.Column="2"
                            Command="{Binding ElementName=root, Path=DataContext.EditCommand}"
                            CommandParameter="{Binding}"
                            Content="&#xE713;"
                            Style="{StaticResource ListIconBtn}"
                            ToolTip="配置" />
                        <Button
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            Command="{Binding ElementName=root, Path=DataContext.DeleteCommand}"
                            CommandParameter="{Binding}"
                            Content="&#xE106;"
                            Style="{StaticResource ListIconBtn}"
                            ToolTip="删除" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ctl:FlowPanel
            Title="{Binding PanelTitle}"
            Grid.RowSpan="2"
            AddCommand="{Binding RuleAddCommand}"
            AddVisible="True"
            BackCommand="{Binding PanelConfirmCommand}"
            BackVisible="True"
            IsOpen="{Binding PanelVisible}">
            <ListBox HorizontalContentAlignment="Stretch" ItemsSource="{Binding RuleItems}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Grid.Row="1" Text="{Binding Values.Count, StringFormat='共{0}个参数'}" />
                            <StackPanel
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Orientation="Horizontal">
                                <Button
                                    Command="{Binding ElementName=root, Path=DataContext.RuleUpCommand}"
                                    CommandParameter="{Binding}"
                                    Content="&#xE110;"
                                    Style="{StaticResource ListIconBtn}"
                                    ToolTip="上移" />
                                <Button
                                    Command="{Binding ElementName=root, Path=DataContext.RuleDownCommand}"
                                    CommandParameter="{Binding}"
                                    Content="&#xE74B;"
                                    Style="{StaticResource ListIconBtn}"
                                    ToolTip="下移" />
                                <Button
                                    Command="{Binding ElementName=root, Path=DataContext.RuleEditCommand}"
                                    CommandParameter="{Binding}"
                                    Content="&#xE104;"
                                    Style="{StaticResource ListIconBtn}"
                                    ToolTip="编辑" />
                                <Button
                                    Command="{Binding ElementName=root, Path=DataContext.RuleDeleteCommand}"
                                    CommandParameter="{Binding}"
                                    Content="&#xE106;"
                                    Style="{StaticResource ListIconBtn}"
                                    ToolTip="删除" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ctl:FlowPanel>
        <ctl:ContentDialog
            Title="添加规则组"
            Grid.RowSpan="2"
            DialogHeight="340"
            IsOpen="{Binding DialogVisible}"
            PrimaryCommand="{Binding DialogConfirmCommand}"
            SubTitle="先设置匹配规则">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource InputHeaderStyle}" Text="组名称" />
                    <TextBox Style="{StaticResource InputEntryStyle}" Text="{Binding GroupName}" />
                    <TextBlock Style="{StaticResource InputHeaderStyle}" Text="匹配方式" />
                    <ctl:RadioGroupPanel Value="{Binding GroupType}" />
                    <TextBlock Style="{StaticResource InputHeaderStyle}" Text="匹配值" />
                    <TextBox Style="{StaticResource InputEntryStyle}" Text="{Binding GroupMatchValue}" />
                </StackPanel>
            </ScrollViewer>
        </ctl:ContentDialog>
        <ctl:ContentDialog
            Title="添加规则"
            Grid.RowSpan="2"
            DialogHeight="400"
            IsOpen="{Binding RuleVisible}"
            PrimaryCommand="{Binding RuleConfirmCommand}"
            SubTitle="设置匹配规则">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource InputHeaderStyle}" Text="插件" />
                    <ComboBox
                        Grid.Row="1"
                        Height="40"
                        ItemsSource="{Binding PluginItems}"
                        SelectedIndex="{Binding PluginIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MetaLabelStyle}"
                                        Text="{Binding Description}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ctl:RuleFormPanel
                        Grid.Row="2"
                        DataItems="{Binding RuleDataItems}"
                        InputItems="{Binding RuleInputItems}" />
                </StackPanel>
            </ScrollViewer>
        </ctl:ContentDialog>
    </Grid>
</Page>
